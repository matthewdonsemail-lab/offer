# Twenty CRM Configuration (required)
# With or without a /rest suffix — the backend normalizes it.
TWENTY_BASE_URL=https://twenty.inferencesaver.com
TWENTY_API_KEY=your_twenty_api_key_here

# Twenty Database (optional — enables login verification against Twenty users;
# leave empty to disable password login)
TWENTY_DATABASE_URL=postgresql://user:pass@host:5432/twenty

# Server
PORT=4000

# JWT Secret
JWT_SECRET=your-jwt-secret-change-in-production

# Cloudflare R2 (logo uploads — /api/offers/logo-upload)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_API_TOKEN=your_r2_api_token
CLOUDFLARE_API_TOKEN=your_r2_api_token  # same secret; backend accepts either name
R2_BUCKET=your_r2_bucket_name

# Frontend (Vite — exposed to the browser, no secrets here)
# Local dev points at the Express backend; leave UNSET on Vercel so the
# browser uses same-origin /api/* (rewritten to the serverless function).
VITE_API_URL=http://localhost:4000

# Twenty OAuth sign-in (public PKCE client, no secret)
TWENTY_BASE_URL=
TWENTY_OAUTH_CLIENT_ID=
TWENTY_OAUTH_REDIRECT_URI=http://localhost:3000/callback
TWENTY_OAUTH_SCOPE=api profile
TWENTY_BASIC_USER=
TWENTY_BASIC_PASSWORD=
