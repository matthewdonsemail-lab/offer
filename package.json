{
  "name": "offer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Open-source offer-funnel builder on Twenty CRM — visual landing pages, qualifier quizzes, contact capture, Calendly booking, and thank-you/disqualified paths, all stored as structured CRM data.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "bun run --cwd backend dev",
    "dev:frontend": "bun run --cwd frontend dev",
    "dev": "concurrently --raw --prefix \"[{name}]\" --names \"backend,frontend\" --prefix-colors \"cyan,magenta\" --kill-others-on-fail \"bun run dev:backend\" \"bun run dev:frontend\"",
    "dev:raw": "concurrently --raw \"bun run dev:backend\" \"bun run dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "lefthook": "^2.1.12"
  }
}
